        if self:GetMoney() < BIKE_CRATE_COST then
            if self:ATMMoney() + self:GetMoney() < BIKE_CRATE_COST then return end
            if not Sf:GoToPosition(POS.ATM, 30) then Sf:KillSelf() return end
            task.wait(0.3)
            local needed = BIKE_CRATE_COST - self:GetMoney()
            if needed > 0 then Net.get("transfer_funds", "bank", "hand", needed) task.wait(0.5) end
        end
        if not Sf:GoToPosition(POS.BikeBuy, 35) then Sf:KillSelf() return end
        task.wait(0.3)
        if not Sf:GoToPosition(touchPart.Position, 25) then Sf:KillSelf() return end
        task.wait(0.3)
        if distTo(touchPart.Position) > 12 then
            RootPart:PivotTo(CFrame.new(touchPart.Position + Vector3.new(0, 3, 0)))
            task.wait(0.5)
        end
        Net.get("open_crate", bikeCrate:WaitForChild("CrateOptions"):WaitForChild("Basic"), "money")
        task.wait(1)
    end)
end

