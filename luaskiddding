local function safePos(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then
        local pp = inst.PrimaryPart
        if not pp then
            for _, d in ipairs(inst:GetDescendants()) do
                if d:IsA("BasePart") then pp = d break end
            end
        end
        if pp then return pp.Position end
    end
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("BasePart") then return d.Position end
    end
    return nil
end

local function FindActiveAirdrop()
    local points = workspace:FindFirstChild("AirDropPoints")
    if not points then return nil, nil end
    for _, point in ipairs(points:GetChildren()) do
        local onPoint = point:FindFirstChild("OnPointModel")
        if not onPoint then
            for _, d in ipairs(point:GetDescendants()) do
                if d.Name == "OnPointModel" then onPoint = d break end
            end
        end
        if onPoint and onPoint.Parent then
            local pos = safePos(onPoint)
            if pos then return point, pos end
        end
    end
    return nil, nil
end

local function GetAirdropModelPos()
    local adm = workspace:FindFirstChild("AirDropModel")
    if not adm then return nil end
    return safePos(adm)
end

local function FindCratePrompt()
    local adm = workspace:FindFirstChild("AirDropModel")
    if adm then
        local prompts = {}
        for _, d in ipairs(adm:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                if d.Parent and d.Parent.Name == "BoxInteriorBottom" then return d end
                table.insert(prompts, d)
            end
        end
        if #prompts > 0 then return prompts[1] end
    end
    for _, parent in ipairs(workspace:GetChildren()) do
        local wc = parent:FindFirstChild("Weapon Crate", true)
        if wc then
            local model = wc:FindFirstChild("Model")
            if model then
                local box = model:FindFirstChild("BoxInteriorBottom")
                if box then
                    local prompt = box:FindFirstChild("ProximityPrompt")
                    if prompt and prompt:IsA("ProximityPrompt") then return prompt end
                end
            end
        end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Parent and d.Parent.Name == "BoxInteriorBottom" then
            return d
        end
    end
    return nil
end

-- FIX: TriggerCratePrompt mit echter Hold-Simulation
local function TriggerCratePrompt()
    local prompt = FindCratePrompt()
    if not prompt then return false end

    local originalHold = prompt.HoldDuration or 0
    local holdTime = math.max(originalHold, Config.AirdropHoldDuration)

    pcall(function()
        prompt.MaxActivationDistance = 100
        prompt.RequiresLineOfSight = false
    end)

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    -- Echte Hold-Simulation
    local ok1 = pcall(function()
        prompt:InputHoldBegin()
        task.wait(holdTime + 0.15)
        prompt:InputHoldEnd()
    end)

    -- Fallback
    local ok2 = pcall(function()
        fireproximityprompt(prompt)
    end)

    return ok1 or ok2
end

local function ADNotify(title, desc, duration)
    pcall(function()
        WindUI:Notify({ Title = title, Content = desc, Duration = duration or 4 })
    end)
end

-- FIX: AirdropLoop mit Distanz-Checks vor Öffnen
local function AirdropLoop()
    local lastPointName = nil
    while Config.AutoOpenAirdrop do
        local ok, err = pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then
                ADStatusLabel:SetDesc("Tot - warte")
                task.wait(1)
                return
            end

            local point, pointPos = FindActiveAirdrop()

            if not point then
                ADStatusLabel:SetDesc("Keins")
                ADPointLabel:SetDesc("Keiner")
                ADDistanceLabel:SetDesc("-")
                ADCrateLabel:SetDesc("Keine")
                lastPointName = nil
                return
            end

            -- Ziel = Landepunkt (OnPointModel)
            local targetPos = pointPos

            if lastPointName ~= point.Name then
                ADPointLabel:SetDesc(point.Name)
                ADStatusLabel:SetDesc("Airdrop aktiv")
                ADNotify("📦 Airdrop!", tostring(point.Name) .. " - fahre hin...", 5)
                lastPointName = point.Name
            end

            local root = char:FindFirstChild("HumanoidRootPart")
            local dist = 9999
            if targetPos and root then
                dist = (targetPos - root.Position).Magnitude
                ADDistanceLabel:SetDesc(string.format("%.0f m", dist))
            end

            -- Hinfahren wenn weit weg
            if targetPos and dist > 8 then
                ADStatusLabel:SetDesc("Fahre hin...")
                pcall(function() Sf:TravelTo(targetPos, Config.AirdropStayFlying) end)
                task.wait(0.3)

                if root then
                    dist = (targetPos - root.Position).Magnitude
                    ADDistanceLabel:SetDesc(string.format("%.0f m", dist))
                end
            end

            -- Zu weit weg -> nicht öffnen
            if dist > 12 then
                ADStatusLabel:SetDesc("Zu weit (" .. math.floor(dist) .. "m)")
                ADCrateLabel:SetDesc("Warte...")
                return
            end

            -- Prompt suchen
            local prompt = FindCratePrompt()
            if not prompt then
                ADCrateLabel:SetDesc("Noch nicht gelandet")
                ADStatusLabel:SetDesc("Warte auf Landung...")
                return
            end

            -- Prompt-Position prüfen
            local promptPos = nil
            if prompt.Parent then
                local pPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                if pPart then promptPos = pPart.Position end
            end

            if promptPos and root then
                local pDist = (promptPos - root.Position).Magnitude
                if pDist > 15 then
                    ADStatusLabel:SetDesc("Crate zu weit (" .. math.floor(pDist) .. "m)")
                    return
                end
            end

            -- Jetzt öffnen
            ADCrateLabel:SetDesc("Gefunden ✓")
            ADStatusLabel:SetDesc("Öffne Crate...")
            local opened = false
            for i = 1, 10 do
                if not Config.AutoOpenAirdrop then break end

                if promptPos and root then
                    local pDist = (promptPos - root.Position).Magnitude
                    if pDist > 15 then
                        ADStatusLabel:SetDesc("Zu weit - breche ab")
                        break
                    end
                end

                if TriggerCratePrompt() then
                    opened = true
                    ADStatusLabel:SetDesc("Geöffnet ✓")
                    ADNotify("✅ Crate geöffnet!", "Versuch " .. i, 3)
                    break
                end
                task.wait(0.5)
            end

            if not opened then
                ADStatusLabel:SetDesc("Öffnen fehlgeschlagen")
                ADCrateLabel:SetDesc("Prompt fail")
            end

            task.wait(2)
        end)

        if not ok then
            ADStatusLabel:SetDesc("Fehler: " .. tostring(err):sub(1, 40))
        end
        task.wait(Config.AirdropScanInterval)
    end
    ADStatusLabel:SetDesc("Inaktiv")
end

