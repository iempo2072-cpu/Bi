function Sf:GetInfo(w)
    local amount, IsHaving, Uid, Using, Drowning = 0, false, nil, false, false
    local Items = PlayerGui:FindFirstChild("Items")
    if not Items then return {0, false, nil, false, false} end
    local holder = Items:FindFirstChild("ItemsHolder")
    if not holder then return {0, false, nil, false, false} end
    local Holding = holder:FindFirstChild("ItemsScrollingFrame")
    if not Holding then return {0, false, nil, false, false} end
    for _, v in pairs(Holding:GetChildren()) do
        if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
            local itemName = v:FindFirstChild("ItemName")
            if itemName and itemName.Text == w then
                Uid = v.Name
                amount = amount + 1
                IsHaving = true
                local eq = v:FindFirstChild('ItemEquipped')
                local di = v:FindFirstChild('DestroyedItemIcon')
                Using = eq and eq.Visible or false
                Drowning = di and di.Visible or false
            end
        end
    end
    return {amount, IsHaving, Uid, Using, Drowning}
end

